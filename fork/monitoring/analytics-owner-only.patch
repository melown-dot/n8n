diff --git a/src/utils/ownerPolicy.js b/src/utils/ownerPolicy.js
new file mode 100644
index 0000000..ced3ebc
--- /dev/null
+++ b/src/utils/ownerPolicy.js
@@ -0,0 +1,7 @@
+// Personal deployment policy: live source authorization, independent of replica membership.
+const ownerOnlyEnabled = () => process.env.ANALYTICS_OWNER_ONLY === 'true';
+function allowedOwner(user, tokenUser) {
+    return Boolean(user && user.roleSlug === 'global:owner' && !user.disabled && !user.mfaEnabled &&
+        (!tokenUser || (user.id === tokenUser.id && user.email === tokenUser.email && tokenUser.role === 'global:owner')));
+}
+module.exports = { ownerOnlyEnabled, allowedOwner };
diff --git a/test/owner-policy.test.js b/test/owner-policy.test.js
new file mode 100644
index 0000000..9e7350a
--- /dev/null
+++ b/test/owner-policy.test.js
@@ -0,0 +1,53 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { allowedOwner } = require('../src/utils/ownerPolicy');
+const owner = { id: 'o', email: 'o@local', roleSlug: 'global:owner', disabled: false, mfaEnabled: false };
+const token = { id: 'o', email: 'o@local', role: 'global:owner' };
+test('personal policy grants only live matching owner without MFA', () => {
+    assert.equal(allowedOwner(owner, token), true);
+    assert.equal(allowedOwner(owner), true);
+    for (const current of [null, {}, {...owner, roleSlug: null}, {...owner, roleSlug: 'global:member'}, {...owner, roleSlug: 'global:admin'}, {...owner, disabled: true}, {...owner, mfaEnabled: true}, {...owner, id: 'other'}]) {
+        assert.equal(allowedOwner(current, token), false);
+    }
+    assert.equal(allowedOwner(owner, {...token, role: 'global:member'}), false);
+});
+test('missing replica membership cannot grant member or unknown schema access', () => {
+    for (const roleSlug of [undefined, null, 'global:member', 'global:admin']) {
+        assert.equal(allowedOwner({...owner, roleSlug}), false);
+    }
+});
+test('middleware fails closed for unavailable source, missing owner schema and stale/member JWT', async () => {
+    const fs = require('node:fs');
+    const os = require('node:os');
+    const path = require('node:path');
+    const jwt = require('jsonwebtoken');
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'owner-policy-'));
+    process.env.DASHBOARD_DB_PATH = path.join(dir, 'policy.sqlite');
+    process.env.DASHBOARD_JWT_SECRET = 'test-owner-policy-secret-at-least-32-characters';
+    process.env.ANALYTICS_OWNER_ONLY = 'true';
+    const userDao = require('../src/dao/userDao');
+    const db = require('../src/config/localDb');
+    await db.ready;
+    const { authenticateToken } = require('../src/middlewares/auth');
+    const original = userDao.findByEmail;
+    const call = (claims) => new Promise((resolve) => {
+        const response = { status(code) { this.code=code; return this; }, json() { resolve(this.code); } };
+        authenticateToken({headers:{authorization:'Bearer '+jwt.sign(claims,process.env.DASHBOARD_JWT_SECRET)}}, response, () => resolve(200));
+    });
+    try {
+        userDao.findByEmail = async () => owner;
+        assert.equal(await call(token), 200);
+        assert.equal(await call({...token, role:'global:member'}), 403);
+        userDao.findByEmail = async () => ({...owner, roleSlug: undefined});
+        assert.equal(await call(token), 403);
+        userDao.findByEmail = async () => null;
+        assert.equal(await call(token), 403);
+        userDao.findByEmail = async () => { throw new Error('source unavailable'); };
+        assert.equal(await call(token), 503);
+    } finally {
+        userDao.findByEmail = original;
+        delete process.env.ANALYTICS_OWNER_ONLY;
+        await new Promise((resolve) => db.close(resolve));
+        fs.rmSync(dir, { recursive:true, force:true });
+    }
+});
