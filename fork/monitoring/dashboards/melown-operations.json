{
  "uid": "melown-operations",
  "title": "Melown — сервер, Docker и Скорозвон → Plex",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Europe/Moscow",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "melown",
    "operations",
    "low-overhead"
  ],
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Сбор данных: 1 — работает / 0 — проблема",
      "description": "Host/Docker/цепочка опрашиваются раз в минуту. 0, No data или возраст >3мин означают проблему сбора; это не исправность бизнес-сервисов.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(melown_collector_success) * (time()-max(melown_collector_timestamp_seconds) < bool 180)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ПРОБЛЕМА СБОРА",
                  "color": "red"
                },
                "1": {
                  "text": "ДАННЫЕ СВЕЖИЕ",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CPU сервера",
      "description": "Средняя загрузка всех ядер за5мин. После первого запуска нужны минимум2точки.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * (1 - sum(rate(melown_host_cpu_seconds_total{mode=\"idle\"}[5m])) / sum(rate(melown_host_cpu_seconds_total[5m])))) and on() ((melown_collector_success{component=\"host\"} == 1) and (time()-melown_collector_last_success_timestamp_seconds{component=\"host\"} < 180))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
